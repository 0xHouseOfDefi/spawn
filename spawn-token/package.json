{
  "name": "@spawn/token",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./economy-policy": {
      "types": "./dist/economy-policy.d.ts",
      "import": "./dist/economy-policy.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@pump-fun/pump-sdk": "2.0.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bigint-buffer": "file:packages/bigint-buffer",
    "bs58": "6.0.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@coral-xyz/anchor": {
      "toml": "5.0.1"
    },
    "bigint-buffer": "$bigint-buffer",
    "jayson": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
